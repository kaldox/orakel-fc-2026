# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env

# Langer, zufaelliger Wert. Erzeugen z.B. mit:  openssl rand -hex 32
SECRET_KEY=bitte-hier-einen-langen-zufallswert-eintragen

# Erster Admin-Account (wird beim ersten Start automatisch angelegt).
ADMIN_NAME=admin
ADMIN_PASSWORD=bitte-unbedingt-aendern

# App-Name (erscheint im Browser-Tab) und gleichzeitig der Name des beim
# allerersten Start automatisch angelegten Turniers - danach unter
# Admin -> Turniere frei umbenennbar/erweiterbar (mehrere Turniere parallel
# moeglich, siehe README).
LEAGUE_NAME=ORAKEL FC

# Optional: Format des beim ersten Start automatisch angelegten Turniers -
# league | cup | group_knockout | swiss (siehe README). Nur eine Vorbelegung
# fuer Spieltag-/Phasen-Bezeichnungen, aendert die Wertung nicht.
# COMPETITION_FORMAT=group_knockout

# Interner Port im Container (muss zur docker-compose.yml passen).
PORT=8090

# Auf 1 setzen, sobald die App über HTTPS läuft (sicherere Cookies):
COOKIE_SECURE=0
